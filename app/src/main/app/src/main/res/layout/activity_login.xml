<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0C"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DSX AI VIDEO"
            android:textColor="#00E5FF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign in to save your cloud projects"
            android:textColor="#888888"
            android:textSize="14sp"
            android:layout_marginBottom="36dp" />

        <!-- Google One-Tap Sign In Button -->
        <Button
            android:id="@+id/btnGoogleAuth"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="🌐 Continue with Google Account"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#DB4437"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnFacebookAuth"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="📘 Continue with Facebook"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#4267B2"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="— OR LOGIN WITH EMAIL / PHONE —"
            android:textColor="#555555"
            android:textSize="12sp"
            android:layout_marginBottom="20dp" />

        <EditText
            android:id="@+id/etAuthInput"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#16161A"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:hint="Email or Phone Number"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etAuthPassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#16161A"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:hint="Password"
            android:inputType="textPassword"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="14sp"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnLoginEmail"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Sign In / Create Account"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0088FF"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
